# Sable's local config. setup.ps1 copies this to .env (gitignored) and asks
# for your name. Real environment variables with the same names win over .env.
# Settings changed in Sable's Settings window win over both.

# What Sable calls you.
SABLE_USER_NAME=

# llama.cpp server (OpenAI-compatible /v1/chat/completions, plus /health and /slots).
SABLE_LLM_URL=http://127.0.0.1:8080
# Slot reserved for Sable when llama-server runs with -np 2 (slot 0 stays free
# for your coding agent). -1 lets the server pick (single-slot servers).
SABLE_LLM_SLOT=1
# How Sable refers to the machine her brain runs on ("Napping until ___ comes back").
SABLE_BRAIN_NAME=the GPU

# Pocket TTS server (setup.ps1 installs it; Sable starts it herself).
SABLE_TTS_URL=http://127.0.0.1:8890
# Preset voice (alba, azelma, cosette, eponine, ...) or a path to a .safetensors/.wav.
# A custom tts/voices/sable.safetensors is used automatically if present.
SABLE_TTS_VOICE=azelma

# Folder with SOUL.md (who Sable is) and optional USER.md (about you).
# Empty = the persona/ folder next to Sable. If you use pi-persona, point this
# at your pi agent dir (e.g. C:/Users/you/.pi/agent) and Sable mirrors its mood too.
SABLE_PERSONA_DIR=

# Dev only: Godot 4.7.2 editor exe for run.ps1 and tools/package.ps1.
GODOT=
